#! /bin/bash

# SOLID Principles Enhanced LEMP Tool Scripts
# Refactored to better adhere to SOLID principles while maintaining backward compatibility

# shellcheck source=scripts/deb_os_tools
source scripts/deb_os_tools
# shellcheck source=scripts/bash_helpers/compatibility
source scripts/bash_helpers/compatibility

# Initialize environment detection
detect_environment

#===============================================================================
# CONFIGURATION AND CONSTANTS (Open/Closed Principle)
#===============================================================================

# Configuration-driven approach for better maintainability and extensibility
declare -A PHP_PACKAGES_CORE=(
    ["base"]="php\$PHP_VERSION php\$PHP_VERSION-fpm php\$PHP_VERSION-cli"
    ["database"]="php\$PHP_VERSION-sqlite3 php\$PHP_VERSION-mysql"
    ["web"]="php\$PHP_VERSION-xml php\$PHP_VERSION-xmlrpc php\$PHP_VERSION-curl php\$PHP_VERSION-gd"
    ["dev"]="php\$PHP_VERSION-dev php\$PHP_VERSION-mbstring php\$PHP_VERSION-opcache"
    ["extended"]="php\$PHP_VERSION-soap php\$PHP_VERSION-zip php\$PHP_VERSION-intl php\$PHP_VERSION-bcmath"
    ["system"]="php\$PHP_VERSION-bz2 php\$PHP_VERSION-ctype php\$PHP_VERSION-gmp php\$PHP_VERSION-imap"
)

declare -A PHP_PACKAGES_OPTIONAL=(
    ["debug"]="php\$PHP_VERSION-xdebug"
    ["imaging"]="php\$PHP_VERSION-imagick"
)

declare -A LARAVEL_PACKAGES=(
    ["vcs"]="git"
    ["database"]="sqlite3"
    ["runtime"]="nodejs npm"
)

#===============================================================================
# ABSTRACT INTERFACES (Dependency Inversion Principle)
#===============================================================================

# Service Manager Interface - abstracts service operations
service_operation() {
    local operation="$1"
    local service="$2"
    
    case "$operation" in
        "start"|"stop"|"restart"|"enable"|"disable")
            service_manager "$operation" "$service"
            ;;
        *)
            echo "Error: Invalid service operation: $operation"
            return 1
            ;;
    esac
}

# Package Manager Interface - abstracts package operations  
package_operation() {
    local operation="$1"
    shift
    local packages=("$@")
    
    case "$operation" in
        "install")
            packages_installer -y "${packages[@]}"
            ;;
        "install_safe")
            install_packages_safe -y "${packages[@]}"
            ;;
        "check_available")
            apt-cache show "$1" >/dev/null 2>&1
            ;;
        *)
            echo "Error: Invalid package operation: $operation"
            return 1
            ;;
    esac
}

# File System Interface - abstracts file operations
file_operation() {
    local operation="$1"
    local file_path="$2"
    local content="$3"
    
    case "$operation" in
        "create_from_template")
            local template_path="$content"
            if ! envsubst < "$template_path" > "$file_path"; then
                echo "Error: Failed to create file from template: $template_path -> $file_path"
                return 1
            fi
            ;;
        "check_exists")
            [[ -f "$file_path" ]]
            ;;
        "remove")
            rm -f "$file_path"
            ;;
        *)
            echo "Error: Invalid file operation: $operation"
            return 1
            ;;
    esac
}

#===============================================================================
# VALIDATION LAYER (Single Responsibility Principle)
#===============================================================================

# Component Validators - each validates one specific component
validate_component_mariadb() {
    if ! command -v mysql &> /dev/null; then
        echo "MariaDB is not installed. Install with: ./lemptool -mdb"
        return 1
    fi
}

validate_component_php() {
    if ! command -v php &> /dev/null; then
        echo "PHP is not installed. Install with: ./lemptool -p=<version>"
        return 1
    fi
}

validate_component_nginx() {
    if ! command -v nginx &> /dev/null; then
        echo "Nginx is not installed. Install with: ./lemptool -ng"
        return 1
    fi
}

validate_component_envsubst() {
    if ! command -v envsubst &> /dev/null; then
        echo "envsubst is not available. Install gettext-base package."
        return 1
    fi
}

# Parameter Validators
validate_parameter_not_empty() {
    local param_name="$1"
    local param_value="$2"
    local usage_example="$3"
    
    if [[ -z "$param_value" ]]; then
        echo "Error: $param_name parameter is required"
        [[ -n "$usage_example" ]] && echo "Usage: $usage_example"
        return 1
    fi
}

validate_parameter_user_exists() {
    local username="$1"
    
    if ! id "$username" >/dev/null 2>&1; then
        echo "Error: User '$username' does not exist"
        return 1
    fi
}

validate_parameter_directory_exists() {
    local directory="$1"
    
    if [[ ! -d "$directory" ]]; then
        echo "Error: Directory '$directory' does not exist"
        return 1
    fi
}

#===============================================================================
# UTILITY FUNCTIONS (Single Responsibility Principle)
#===============================================================================

# PHP Utilities
get_php_version_number() {
    php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;"
}

get_php_config_path() {
    local php_version
    php_version="$(get_php_version_number)"
    echo "/etc/php/$php_version"
}

# Argument Processing Utilities
has_confirmation_flag() {
    local confirmation=0
    for arg in "$@"; do
        if [[ "$arg" == "-y" ]]; then
            confirmation=1
            break
        fi
    done
    return $((1 - confirmation))
}

# User Management Utilities
create_user_if_not_exists() {
    local username="$1"
    
    if ! validate_parameter_user_exists "$username" 2>/dev/null; then
        echo "Creating user: $username"
        if create_user_safe "$username"; then
            echo "User '$username' created successfully"
            return 0
        else
            echo "Error: Failed to create user '$username'"
            return 1
        fi
    else
        echo "User '$username' already exists"
        return 0
    fi
}

# Enhanced PHP package installation with configuration-driven approach
install_php_packages_enhanced() {
    local php_version="$1"
    
    # Build package list from configuration
    local packages=()
    for category in "${!PHP_PACKAGES_CORE[@]}"; do
        local category_packages
        category_packages=$(eval echo "${PHP_PACKAGES_CORE[$category]}")
        read -ra pkg_array <<< "$category_packages"
        packages+=("${pkg_array[@]}")
    done
    
    echo "> Installing core PHP packages for version $php_version"
    if package_operation "install_safe" "${packages[@]}"; then
        echo "> Core PHP packages installed successfully"
        
        # Try optional packages
        for category in "${!PHP_PACKAGES_OPTIONAL[@]}"; do
            local optional_package
            optional_package=$(eval echo "${PHP_PACKAGES_OPTIONAL[$category]}")
            
            if package_operation "check_available" "$optional_package"; then
                package_operation "install_safe" "$optional_package" || 
                    echo "Warning: Could not install optional package $optional_package"
            else
                echo "Warning: Optional package $optional_package not available for PHP $php_version"
            fi
        done
        
        return 0
    else
        echo "> Error: Failed to install core PHP packages"
        return 1
    fi
}

# Enhanced Composer installation
install_composer_enhanced() {
    echo "> Installing Composer"
    
    cd /tmp || return 1
    
    if command -v curl >/dev/null 2>&1; then
        curl -sS https://getcomposer.org/installer | php -- --quiet
    elif command -v wget >/dev/null 2>&1; then
        wget https://raw.githubusercontent.com/composer/getcomposer.org/76a7060ccb93902cd7576b67264ad91c8a2700e2/web/installer -O - -q | php -- --quiet
    else
        echo "Error: Neither curl nor wget available for Composer installation"
        return 1
    fi
    
    sudo mv composer.phar /usr/local/bin/composer
    echo "> Composer installed successfully"
}

# Enhanced Laravel development packages installation
install_laravel_dev_packages_enhanced() {
    echo "> Installing Laravel development packages"
    
    validate_sudo
    
    local packages=()
    for category in "${!LARAVEL_PACKAGES[@]}"; do
        read -ra pkg_array <<< "${LARAVEL_PACKAGES[$category]}"
        packages+=("${pkg_array[@]}")
    done
    
    package_operation "install" "${packages[@]}"
}

#===============================================================================
# INSTALLER CLASSES (Single Responsibility Principle)
#===============================================================================

# PHP Installer - handles PHP installation and configuration
class_php_installer() {
    local php_version="$1"
    local confirmation=0
    
    # Parse arguments for confirmation flag
    shift
    has_confirmation_flag "$@" && confirmation=1
    
    echo "Starting PHP $php_version installation..."
    
    # Validate prerequisites
    validate_sudo || return 1
    
    # Remove conflicting packages if confirmation given
    if [[ $confirmation -eq 1 ]]; then
        echo "> Removing conflicting Apache packages"
        package_operation "install" "apache2-"
    fi
    
    # Install PHP packages using enhanced method
    if install_php_packages_enhanced "$php_version"; then
        echo "> Configuring PHP-FPM"
        service_operation "enable" "php$php_version-fpm"
        service_operation "start" "php$php_version-fpm"
        
        # Install Composer
        install_composer_enhanced || echo "Warning: Composer installation failed"
        
        echo "PHP $php_version installation completed successfully"
        return 0
    else
        echo "Error: PHP installation failed"
        return 1
    fi
}

# Pool Configuration Manager (Single Responsibility)
class_pool_configurator() {
    local pool_name="$1"
    local user="$2"
    local domain="$3"
    local pool_type="$4"
    
    # Validate required parameters
    validate_parameter_not_empty "pool_name" "$pool_name" "install_php_pool <name> <user> <domain> [type]" || return 1
    validate_parameter_not_empty "user" "$user" "install_php_pool <name> <user> <domain> [type]" || return 1
    validate_parameter_not_empty "domain" "$domain" "install_php_pool <name> <user> <domain> [type]" || return 1
    
    # Set default pool type if not provided
    [[ -z "$pool_type" ]] && pool_type="fpm_general"
    
    # Validate component dependencies
    validate_component_php || return 1
    validate_component_envsubst || return 1
    
    # Validate user exists
    validate_parameter_user_exists "$user" || return 1
    
    # Set environment variables for template processing
    export FPM_USER="$user"
    export FPM_POOL_NAME="$pool_name"
    export DOMAIN_NAME="$domain"
    
    # Determine template and output paths
    local template_file="templates/$pool_type.template"
    local php_version
    php_version="$(get_php_version_number)"
    local output_file="/etc/php/$php_version/fpm/pool.d/$pool_name.conf"
    
    # Create pool configuration from template
    echo "> Creating PHP-FPM pool configuration: $pool_name"
    if file_operation "create_from_template" "$output_file" "$template_file"; then
        echo "> Restarting PHP-FPM service"
        service_operation "restart" "php$php_version-fpm"
        echo "> Pool '$pool_name' configured successfully"
        return 0
    else
        echo "> Error: Failed to configure pool '$pool_name'"
        return 1
    fi
}

# Server Configuration Manager (Single Responsibility)
class_server_configurator() {
    local server_name="$1"
    local user="$2"
    local domain="$3"
    local server_type="$4"
    
    # Validate required parameters
    validate_parameter_not_empty "server_name" "$server_name" "create_nginx_server <name> <user> <domain> [type]" || return 1
    validate_parameter_not_empty "user" "$user" "create_nginx_server <name> <user> <domain> [type]" || return 1
    validate_parameter_not_empty "domain" "$domain" "create_nginx_server <name> <user> <domain> [type]" || return 1
    
    # Set default server type if not provided  
    [[ -z "$server_type" ]] && server_type="general_server"
    
    # Validate component dependencies
    validate_component_nginx || return 1
    validate_component_envsubst || return 1
    
    # Validate user and create if needed
    create_user_if_not_exists "$user" || return 1
    
    # Set environment variables for template processing
    export SERVER_USER="$user"
    export SERVER_NAME="$server_name"
    export DOMAIN_NAME="$domain"
    export USER_HOME_DIR="/home/$user"
    export PROJECT_PATH="/home/$user/$domain"
    
    # Determine template and output paths
    local template_file="templates/$server_type.template"
    local output_file="/etc/nginx/sites-available/$server_name"
    
    echo "> Creating Nginx server configuration: $server_name"
    if file_operation "create_from_template" "$output_file" "$template_file"; then
        # Enable the site
        ln -sf "$output_file" "/etc/nginx/sites-enabled/$server_name"
        
        # Create project directory if it doesn't exist
        if [[ ! -d "$PROJECT_PATH" ]]; then
            echo "> Creating project directory: $PROJECT_PATH"
            sudo -u "$user" mkdir -p "$PROJECT_PATH"
        fi
        
        echo "> Restarting Nginx service"
        service_operation "restart" "nginx"
        echo "> Server '$server_name' configured successfully"
        return 0
    else
        echo "> Error: Failed to configure server '$server_name'"
        return 1
    fi
}

#===============================================================================
# SERVICE CONFIGURATION LAYER (Interface Segregation Principle)
#===============================================================================

# Database Configuration Interface
configure_database_service() {
    local db_name="$1"
    local db_user="$2"
    local db_password="$3"
    
    validate_component_mariadb || return 1
    validate_parameter_not_empty "db_name" "$db_name" "create_db <database> <user> <password>" || return 1
    validate_parameter_not_empty "db_user" "$db_user" "create_db <database> <user> <password>" || return 1
    validate_parameter_not_empty "db_password" "$db_password" "create_db <database> <user> <password>" || return 1
    
    export DB_NAME="$db_name"
    export DB_USER="$db_user"
    export DB_PASSWORD="$db_password"
    
    local sql_file="/tmp/create_user_${db_user}.sql"
    
    if file_operation "create_from_template" "$sql_file" "templates/create_user.sql"; then
        mysql -u root -p < "$sql_file"
        file_operation "remove" "$sql_file"
        echo "Database '$db_name' and user '$db_user' created successfully"
        return 0
    else
        echo "Error: Failed to create database configuration"
        return 1
    fi
}

#===============================================================================
# ORCHESTRATION FUNCTIONS (Open/Closed Principle for extensibility)
#===============================================================================

# Main installation orchestrator - delegates to specialized installers
orchestrate_installation() {
    local component="$1"
    shift
    
    case "$component" in
        "php")
            class_php_installer "$@"
            ;;
        "php_pool")
            class_pool_configurator "$@"
            ;;
        "nginx_server") 
            class_server_configurator "$@"
            ;;
        "database")
            configure_database_service "$@"
            ;;
        *)
            echo "Error: Unknown component: $component"
            return 1
            ;;
    esac
}

#===============================================================================
# BACKWARD COMPATIBILITY LAYER
#===============================================================================

# Original function names maintained for backward compatibility
install_php() {
    orchestrate_installation "php" "$@"
}

install_php_pool() {
    orchestrate_installation "php_pool" "$@" 
}

create_nginx_server() {
    orchestrate_installation "nginx_server" "$@"
}

create_db() {
    orchestrate_installation "database" "$@"
}

# Laravel development environment setup
install_laravel_dev() {
    echo "> Setting up Laravel development environment"
    
    validate_component_php || return 1
    validate_sudo || return 1
    
    install_laravel_dev_packages_enhanced
    
    echo "> Laravel development environment setup completed"
}


    if [ $show_confirmations -eq 1 ]; then
        confirmation_message
    else
        echo "> message:"
        echo "Confirmation avoided !"
    fi

    # Use enhanced OS detection
    get_os_info_enhanced
    validate_distro_name "Ubuntu" "Debian"
    
    # Get compatible MariaDB version for current OS
    local mariadb_version
    mariadb_version=$(get_compatible_mariadb_version)
    echo "> message:"
    echo "Installing MariaDB version $mariadb_version for $CURRENT_DISTRO_NAME $CURRENT_DISTRO_VERSION"

    # Handle Ubuntu 24.04 (Noble) with special case
    if [[ $CURRENT_DISTRO_NAME == "Ubuntu" && $CURRENT_DISTRO_VERSION == "24.04" ]]; then
        echo "> message:"
        echo "Detected Ubuntu Noble (24.04). Using the repository setup script."

        # Add MariaDB repository using the official script

# FMP Pool Configuration
configure_fpm_pool() {
    local username="$1"
    
    validate_component_php || return 1
    validate_component_envsubst || return 1
    validate_parameter_not_empty "username" "$username" "./lemptool -fpm=myusername"
    
    # Validate or create user
    if ! validate_parameter_user_exists "$username" 2>/dev/null; then
        echo "User '$username' does not exist. Creating..."
        create_user_if_not_exists "$username" || return 1
    fi
    
    # Security check
    if [[ "$username" == "root" ]]; then
        echo "Error: Cannot create FPM pool for root user (security risk)"
        return 1
    fi
    
    local php_version
    php_version=$(get_php_version_number)
    local php_config_path
    php_config_path=$(get_php_config_path)
    local pool_file="$php_config_path/fmp/pool.d/$username.conf"
    
    # Setup environment variables for template
    export DOLLAR="$"
    export PERCENT="%"
    export FPM_USER="$username"
    
    # Handle existing pool file
    if file_operation "check_exists" "$pool_file"; then
        echo "FPM pool file exists. Overwriting..."
        if [[ "$show_confirmations" -eq 1 ]]; then
            confirmation_message || return 1
        fi
        file_operation "remove" "$pool_file"
    fi
    
    # Create pool file from template
    if file_operation "create_from_template" "$pool_file" "templates/fpm_create/pool_template"; then
        echo "> FPM pool file created successfully"
    else
        echo "> Error: Failed to create FPM pool file"
        return 1
    fi
    
    # Restart FPM service
    if service_operation "restart" "php$php_version-fpm"; then
        echo "> PHP-FPM restarted successfully"
    else
        echo "> Warning: PHP-FPM service restart failed"
        if [[ "$LEMPTOOL_ENVIRONMENT" == "container" ]]; then
            echo "> Note: This is normal in container environments"
        else
            return 1
        fi
    fi
    
    echo "> FPM pool creation completed successfully"
}

# Nginx Server Configuration
configure_nginx_server() {
    local fmp_name="$1"
    local domain="$2"
    local public_path="$3"
    
    validate_component_nginx || return 1
    validate_component_php || return 1
    validate_component_envsubst || return 1
    
    validate_parameter_not_empty "FPM name" "$fmp_name"
    validate_parameter_not_empty "domain" "$domain"
    validate_parameter_not_empty "public path" "$public_path"
    validate_parameter_directory_exists "$public_path"
    
    local php_version
    php_version=$(get_php_version_number)
    local php_config_path
    php_config_path=$(get_php_config_path)
    local pool_file="$php_config_path/fmp/pool.d/$fmp_name.conf"
    
    # Ensure FPM pool exists
    if ! file_operation "check_exists" "$pool_file"; then
        echo "> FPM pool does not exist. Creating..."
        configure_fmp_pool "$fmp_name" || return 1
    fi
    
    # Restart PHP-FPM to ensure pool is loaded
    service_operation "restart" "php$php_version-fpm" || return 1
    
    # Setup environment variables for template
    export DOLLAR="$"
    export PERCENT="%"
    export NG_SERVER_PATH="$public_path"
    export NG_SERVER_DOMAIN="$domain"
    export NG_SERVER_FPM_NAME="$fmp_name"
    
    local available_path="/etc/nginx/sites-available"
    local enabled_path="/etc/nginx/sites-enabled"
    local server_file="$available_path/$domain"
    
    # Handle existing server file
    if file_operation "check_exists" "$server_file"; then
        echo "Nginx server file exists. Overwriting..."
        if [[ "$show_confirmations" -eq 1 ]]; then
            confirmation_message || return 1
        fi
        file_operation "remove" "$server_file"
    fi
    
    # Create server file from template
    if file_operation "create_from_template" "$server_file" "templates/laravel/nginx/server/server_unit_template"; then
        echo "> Nginx server file created successfully"
    else
        echo "> Error: Failed to create Nginx server file"
        return 1
    fi
    
    # Create symbolic link
    ln -sf "$server_file" "$enabled_path/$domain"
    
    # Test nginx configuration
    if nginx -t; then
        echo "> Nginx configuration is valid"
    else
        echo "> Error: Nginx configuration is invalid"
        return 1
    fi
    
    # Restart Nginx
    if service_operation "restart" "nginx"; then
        echo "> Nginx restarted successfully"
    else
        echo "> Warning: Nginx service restart failed"
        if [[ "$LEMPTOOL_ENVIRONMENT" == "container" ]]; then
            echo "> Note: This is normal in container environments"
        else
            return 1
        fi
    fi
    
    echo "> Nginx server configuration completed successfully"
}


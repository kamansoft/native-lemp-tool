# Main PHP Installation Orchestrator
install_php() {
    local php_version="$1"
    
    validate_sudo || return 1
    validate_php_version "$php_version" || return 1
    
    echo "> Starting PHP $PHP_VERSION installation"
    echo "> This will install PHP $PHP_VERSION with FastCGI and Laravel development packages"
    
    # Handle confirmation
    if [[ "$show_confirmations" -eq 1 ]]; then
        confirmation_message || return 1
    else
        echo "> Confirmation avoided"
    fi
    
    # Install repository management packages
    install_deb_repo_packages || return 1
    validate_distro_name "Ubuntu" "Debian" || return 1
    
    # Setup appropriate repository
    setup_php_repository "$CURRENT_DISTRO_NAME" || return 1
    
    # Update package lists
    sudo apt update || return 1
    
    # Install PHP packages
    install_php_packages "$PHP_VERSION" || return 1
    
    # Install Composer
    if [[ "$show_confirmations" -eq 1 ]]; then
        echo "> Installing Composer"
        confirmation_message || return 1
    fi
    
    install_composer || return 1
    install_laravel_dev_packages || return 1
    
    echo "> PHP installation completed successfully"
}

# Main FPM Pool Creation Function
fmp_create() {
    local username="$1"
    
    validate_sudo || return 1
    configure_fmp_pool "$username"
}

# Main Nginx Server Creation Function
fmp_ng_server_create() {
    local fmp_name="$1"
    local domain="$2"
    local public_path="$3"
    
    validate_sudo || return 1
    configure_nginx_server "$fmp_name" "$domain" "$public_path"
}

# Complete LEMP Stack Creation
lemp_create() {
    local user="$1"
    local domain="$2"
    local db_password="$3"
    local custom_path="$4"
    
    validate_sudo || return 1
    validate_component_php || return 1
    validate_component_nginx || return 1
    validate_component_mariadb || return 1
    
    validate_parameter_not_empty "user" "$user" './lemptool lemp="username" "domain" "dbpassword"'
    validate_parameter_not_empty "domain" "$domain" './lemptool lemp="username" "domain" "dbpassword"'
    validate_parameter_not_empty "database password" "$db_password" './lemptool lemp="username" "domain" "dbpassword"'
    validate_parameter_user_exists "$user" || return 1
    
    # Setup directory structure
    local lemp_path
    lemp_path=$(setup_lemp_directories "$user" "$domain" "$custom_path")
    
    # Create symbolic link
    ln -sf "$lemp_path" "/home/$user/$domain"
    
    # Create FPM pool
    configure_fmp_pool "$user" || return 1
    
    # Create database user (escape domain name)
    local escaped_domain
    escaped_domain=$(echo "$domain" | sed 's/\./_/g' | sed 's/-/_/g')
    
    if add_mdb_user_with_db "$escaped_domain" "$db_password"; then
        echo "> Database user created successfully"
    else
        echo "> Warning: Database user creation failed"
        if [[ "$show_confirmations" -eq 1 ]]; then
            echo "> Continue without database?"
            confirmation_message || return 1
        fi
    fi
    
    # Create Nginx server
    configure_nginx_server "$user" "$domain" "$lemp_path" || return 1
    
    # Create index.php from template
    export CURRENT_PHP_VERSION="$(get_php_version_number)"
    export LEMP_USER="$user"
    export LEMP_PATH="$lemp_path"
    export LEMP_DOMAIN="$domain"
    export LEMP_DOMAIN_ESCAPED="$escaped_domain"
    
    file_operation "create_from_template" "$lemp_path/index.php" "templates/lemp/index.php.template"
    
    # Set proper ownership
    chown -R "$user:$user" "$lemp_path"
    
    echo ""
    echo "> LEMP stack created successfully:"
    echo ">   User: $user"
    echo ">   Domain: $domain"
    echo ">   Path: $lemp_path"
    echo ">   Database: $escaped_domain"
    echo ">   DB Password: $db_password"
    
    return 0
}


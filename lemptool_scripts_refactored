# Keep original validate_php_version function as is for compatibility
validate_php_version() {
    local PROSPECT_VERSION=$1
    
    # Get compatible PHP versions for current OS
    local compatible_versions
    compatible_versions=$(get_compatible_php_versions)
    read -ra valid_php_versions <<< "$compatible_versions"
    
    export VALUE_SELECTED_FROM_ARGS
    if [[ -n $PROSPECT_VERSION ]]; then
        echo "Checking if php version $PROSPECT_VERSION is among the valid ones for this script to use."
        # Check if the version is in our compatible list
        for version in "${valid_php_versions[@]}"; do
            if [[ "$PROSPECT_VERSION" == "$version" ]]; then
                VALUE_SELECTED_FROM_ARGS="$PROSPECT_VERSION"
                export PHP_VERSION=$VALUE_SELECTED_FROM_ARGS
                echo "PHP version $PHP_VERSION selected and validated."
                return 0
            fi
        done
        echo "PHP version $PROSPECT_VERSION is not compatible with your OS."
        echo "Compatible versions: ${valid_php_versions[*]}"
        . ./scripts/bash_helpers/in_arguments "$PROSPECT_VERSION" "${valid_php_versions[@]}"
    else
        echo "You must pick a valid php version for this script to use"
        echo "Compatible versions for your OS: ${valid_php_versions[*]}"
        . ./scripts/bash_helpers/in_arguments "x.x" "${valid_php_versions[@]}"
    fi
    export PHP_VERSION=$VALUE_SELECTED_FROM_ARGS
}

